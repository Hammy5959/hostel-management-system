# ─────────────────────────────────────────────────────────────
# HMS Backend — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Supabase (required)
SUPABASE_URL=https://dbeacytqrskfmkdhhzix.supabase.co
# Backend-only service role key (never expose to the frontend).
# Supabase dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# JWT (required)
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
# JWT lifetime in seconds (default 1 hour)

# OTP
OTP_LENGTH=6
# Seconds before an OTP expires (default 5 minutes)
OTP_EXPIRATION_SECONDS=300
# Max verification attempts before the OTP is invalidated (default 5)
OTP_MAX_ATTEMPTS=5

# Initial super admin (created by the seeder). The seeder stores only the
# Argon2id hash of SUPER_ADMIN_PASSWORD (never the plaintext) and only sets it
# when the account has no password yet.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=changeme

# CORS — comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Runtime
ENVIRONMENT=development
DEBUG=true
