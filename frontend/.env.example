# Copy to .env.local and fill in real values.
# NEXT_PUBLIC_* values are baked in at build time — restart `pnpm dev` / rebuild after changing.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# App name + logo — priority everywhere (sidebar, topbar, login/OTP, tab
# title, favicon): 1) these env values  2) Settings → Hostel Name / Branding
# logo  3) defaults ("SHMS" + building icon). Leave empty to let admins set
# them from Settings.
NEXT_PUBLIC_APP_NAME=
# Public URL of the logo image.
NEXT_PUBLIC_LOGO_URL=
# Primary brand color as hex (#rrggbb or #rgb) — buttons, links, sidebar,
# charts, and their light/dark shades. Leave empty for the default indigo.
# Prefer a medium/dark color: it's also used as text on white backgrounds.
NEXT_PUBLIC_BRAND_COLOR=
